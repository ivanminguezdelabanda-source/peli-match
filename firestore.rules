rules_version = '2';
// Reglas de Cinder:
// - Cada perfil (users/{uid}) y sus datos (tastes/{uid}: gustos, encuesta, tutorial, matches, descartes y listas)
//   solo los lee y los cambia su dueño.
// - Los nombres de usuario (usernames/{nombre}) son únicos: cada uno apunta a su dueño.
// - Las reseñas las lee cualquiera; solo su autor, con perfil terminado, las escribe o borra.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedAs(uid) { return request.auth != null && request.auth.uid == uid; }
    // Foto: data:URL pequeña hecha por la app (unos 15 KB) o la URL de la foto de Google
    function validPhoto(p) { return p is string && p.size() <= 60000 && (p == '' || p.matches('^(data:image/(jpeg|webp|png);base64,|https://).*')); }
    function validUsername(n) { return n is string && n.matches('^[a-z0-9_][a-z0-9_.]{1,18}[a-z0-9_]$'); }
    function usernameOwner(n) { return getAfter(/databases/$(database)/documents/usernames/$(n)).data.uid; }

    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null && validUsername(name)
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read, delete: if signedAs(uid);
      allow create, update: if signedAs(uid)
        && request.resource.data.keys().hasOnly(['name', 'photo', 'reviewed', 'ready'])
        && request.resource.data.ready is bool
        && validPhoto(request.resource.data.photo)
        && request.resource.data.reviewed is list && request.resource.data.reviewed.size() <= 400
        // con el perfil terminado, el nombre tiene que ser un nombre de usuario reservado por esta cuenta
        && (request.resource.data.ready == false
            ? request.resource.data.name == ''
            : validUsername(request.resource.data.name) && usernameOwner(request.resource.data.name) == uid);
    }

    match /tastes/{uid} {
      allow read, delete: if signedAs(uid);
      allow create, update: if signedAs(uid)
        && request.resource.data.keys().hasOnly(['v', 'n', 'f', 'at', 'survey', 'tour', 'lib', 'passed', 'lists', 'savedAt'])
        && (!('lib' in request.resource.data) || (request.resource.data.lib is list && request.resource.data.lib.size() <= 2000))
        && (!('passed' in request.resource.data) || (request.resource.data.passed is list && request.resource.data.passed.size() <= 3000))
        && (!('lists' in request.resource.data) || (request.resource.data.lists is list && request.resource.data.lists.size() <= 50))
        && (!('survey' in request.resource.data) || request.resource.data.survey == null || request.resource.data.survey is map)
        && (!('tour' in request.resource.data) || request.resource.data.tour is bool)
        && request.resource.data.f is map && request.resource.data.f.size() <= 600
        && request.resource.data.n is number;
    }

    match /movies/{movieId}/reviews/{uid} {
      allow read: if true;
      allow delete: if signedAs(uid);
      allow create, update: if signedAs(uid)
        && request.resource.data.keys().hasOnly(['name', 'photo', 'stars', 'text', 'at'])
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.ready == true
        && request.resource.data.name == getAfter(/databases/$(database)/documents/users/$(uid)).data.name
        && validPhoto(request.resource.data.photo)
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 600
        // la fecha la pone el servidor al publicar; al cambiar solo nombre o foto se conserva
        && (request.resource.data.at == request.time || (resource != null && request.resource.data.at == resource.data.at));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
