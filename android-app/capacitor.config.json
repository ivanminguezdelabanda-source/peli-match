{
  "appId": "io.github.ivanminguez.cinder",
  "appName": "Cinder",
  "webDir": "www",
  "server": {
    "url": "https://ivanminguezdelabanda-source.github.io/peli-match/",
    "errorPath": "index.html",
    "allowNavigation": [
      "ivanminguezdelabanda-source.github.io"
    ]
  },
  "android": {
    "backgroundColor": "#14100f",
    "appendUserAgent": "CinderApp"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "disable",
      "style": "DARK",
      "initialViewportFitValueHint": "cover"
    },
    "StatusBar": {
      "backgroundColor": "#14100f",
      "style": "DARK",
      "overlaysWebView": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_cinder",
      "iconColor": "#E0414B"
    }
  }
}
