<?xml version="1.0" encoding="utf-8"?>
<!-- Widget «La Caja»: la peli sorteada (cartel + título) y el botón para girar otra vez -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/box_pick"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/box_poster"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LA CAJA TE DICE"
                android:textColor="#F2D39B"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/box_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Abre Cinder"
                android:textColor="#F6ECE0"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/box_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#B3A49A"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/box_spin"
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:background="@drawable/widget_spin_bg"
        android:gravity="center"
        android:text="🎲\nGirar"
        android:textColor="#1A1210"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
