<?xml version="1.0" encoding="utf-8"?>
<!-- Widget «Noticias de cine»: cabecera (abre Novedades) y los tres últimos titulares -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/news_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:text="📰  NOTICIAS DE CINE"
        android:textColor="#F2D39B"
        android:textSize="11sp"
        android:letterSpacing="0.08"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/news_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Cargando titulares…"
        android:textColor="#B3A49A"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/news_row1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/news_src1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#E8875B"
            android:textSize="10sp"
            android:letterSpacing="0.06"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/news_title1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#F6ECE0"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/news_row2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/news_src2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#E8875B"
            android:textSize="10sp"
            android:letterSpacing="0.06"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/news_title2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#F6ECE0"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/news_row3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/news_src3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#E8875B"
            android:textSize="10sp"
            android:letterSpacing="0.06"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/news_title3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#F6ECE0"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
